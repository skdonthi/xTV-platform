<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
  xmlns:tizen="http://tizen.org/ns/widgets"
  id="{{APP_ID}}"
  version="{{VERSION}}"
  viewmodes="maximized">
  <tizen:application id="{{TIZEN_APP_ID}}" package="{{TIZEN_PACKAGE_ID}}" required_version="{{TIZEN_VERSION}}" />
  <content src="index.html" />
  <feature name="http://tizen.org/feature/screen.size.normal.1080.1920" />
  <icon src="icon.png" />
  <name>{{DISPLAY_NAME}}</name>
  <tizen:profile name="tv-samsung" />
  <!--
    CRITICAL: Tizen strips inline <script>/<style> under its default CSP, which
    silently blanks the app on real hardware (installs fine, never boots). This
    permissive policy is THE fix learned on CCL. Do not remove.
  -->
  <tizen:content-security-policy>default-src * data: blob: file: filesystem: 'unsafe-inline' 'unsafe-eval'; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline'; img-src * data: file:; font-src * data: file:; connect-src *;</tizen:content-security-policy>
  <access origin="*" subdomains="true" />
  <tizen:allow-navigation>*</tizen:allow-navigation>
  <!-- Production privilege set (ported from the signed XmediaTizen .wgt). Partner
       privileges (avplay/drmplay/streamingtvplayer/systemcontrol/was.partner) need
       a Samsung PARTNER cert; they are inert under a public cert but harmless. -->
  <tizen:privilege name="http://tizen.org/privilege/internet" />
  <tizen:privilege name="http://tizen.org/privilege/application.launch" />
  <tizen:privilege name="http://tizen.org/privilege/network.get" />
  <tizen:privilege name="http://tizen.org/privilege/network.set" />
  <tizen:privilege name="http://tizen.org/privilege/network.profile" />
  <tizen:privilege name="http://tizen.org/privilege/tv.display" />
  <tizen:privilege name="http://tizen.org/privilege/tv.audio" />
  <tizen:privilege name="http://tizen.org/privilege/tv.window" />
  <tizen:privilege name="http://tizen.org/privilege/tv.channel" />
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice" />
  <tizen:privilege name="http://tizen.org/privilege/filesystem.read" />
  <tizen:privilege name="http://tizen.org/privilege/filesystem.write" />
  <tizen:privilege name="http://tizen.org/privilege/download" />
  <tizen:privilege name="http://tizen.org/privilege/alarm" />
  <tizen:privilege name="http://tizen.org/privilege/system" />
  <tizen:privilege name="http://tizen.org/privilege/package.info" />
  <tizen:privilege name="http://tizen.org/privilege/bluetooth" />
  <tizen:privilege name="http://tizen.org/privilege/bluetooth.gap" />
  <tizen:privilege name="http://tizen.org/privilege/bluetooth.health" />
  <tizen:privilege name="http://developer.samsung.com/privilege/avplay" />
  <tizen:privilege name="http://developer.samsung.com/privilege/drmplay" />
  <tizen:privilege name="http://developer.samsung.com/privilege/streamingtvplayer" />
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo" />
  <tizen:privilege name="http://developer.samsung.com/privilege/tvinfo" />
  <tizen:privilege name="http://developer.samsung.com/privilege/systemcontrol" />
  <tizen:privilege name="http://developer.samsung.com/privilege/network.public" />
  <tizen:privilege name="http://developer.samsung.com/privilege/network.softAP" />
  <tizen:privilege name="http://developer.samsung.com/privilege/widgetdata" />
  <tizen:privilege name="http://developer.samsung.com/privilege/hostedapp_deviceapi_allow" />
  <tizen:privilege name="http://developer.samsung.com/privilege/was.partner" />
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable" />
  <!-- Samsung TV app metadata (deployment requirement). -->
  <tizen:metadata key="http://samsung.com/tv/metadata/use.network" value="false" />
</widget>
